# Stytch public token — find it at https://stytch.com/dashboard?project_id=<your-project-id>
# Use a test project token for staging and a live project token for production.
NEXT_PUBLIC_STYTCH_PUBLIC_TOKEN=

# Crossmint environment: "staging" or "production".
# Optional. When unset, the API key prefix below decides (ck_staging_ / ck_production_).
NEXT_PUBLIC_CROSSMINT_ENVIRONMENT=staging

# Crossmint client-side API key. It must belong to the environment above:
#   staging    → ck_staging_...    (https://staging.crossmint.com/console/projects/apiKeys)
#   production → ck_production_... (https://www.crossmint.com/console/projects/apiKeys)
NEXT_PUBLIC_CROSSMINT_CLIENT_API_KEY=

# Extra hosts allowed to call server actions, comma separated. Only needed behind a tunnel or proxy.
# SERVER_ACTIONS_ALLOWED_ORIGINS=my-tunnel.example.com
