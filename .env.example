# Stytch public token — find it at https://stytch.com/dashboard?project_id=<your-project-id>
NEXT_PUBLIC_STYTCH_PUBLIC_TOKEN=

# Crossmint client-side API key. The prefix selects the environment:
#   ck_staging_...    → staging    (https://staging.crossmint.com/console/projects/apiKeys)
#   ck_production_... → production (https://www.crossmint.com/console/projects/apiKeys)
NEXT_PUBLIC_CROSSMINT_CLIENT_API_KEY=
